    "    \"mepem\"   : [observables_latex[\"mepem\"],   r\"GeV\", [ 81., 101.,  2], [[2e-3, 2e2],     [0.98,  1.05 ],], [True,  False,], [{\"legloc\": \"upper right\",}, {},], ],  # [ 81., 101.,  0.5]\n",
    "    \"dphiee\"  : [observables_latex[\"dphiee\"],  r\"\",    [  0., 180.,   ], [[-0.002, 0.135], [0.95,  1.20 ],], [False, False,], [{\"legloc\": \"center left\",}, {},], ],  # [  0., 180.,   6.]\n",
    "    \"ptee\"    : [observables_latex[\"ptee\"],    r\"GeV\", [  0., 600.,  2], [[5e-8, 9e0],     [0.75,  1.45 ],], [True,  False,], [{\"legloc\": \"upper right\",}, {},], ],  # [  0., 600.,  15.]\n",
